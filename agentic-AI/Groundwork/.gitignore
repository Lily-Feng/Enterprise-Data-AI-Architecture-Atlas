__pycache__/
*.pyc

# Derived corpus. All of it rebuilds from corpus/manifest.json with:
#   python3 -m groundwork.corpus refresh --force
#
# It is deliberately not committed. Retrieval is supposed to reflect what the
# agencies publish today, and a snapshot in git is a snapshot that goes quietly
# stale -- which is the exact failure this project exists to prevent.
corpus/raw/
corpus/chunks.jsonl
corpus/index/
corpus/corpus.lock.json

# Run logs. Append-only, one file per run, regenerated by running things.
# runs/index.jsonl is the exception: one line per run, small enough to commit,
# so the history of what was generated and when survives a cleanup.
runs/*
!runs/index.jsonl

# Committed on purpose, so do not add them here:
#   corpus/manifest.json   what to fetch, and how often
#   corpus/watch.json      the specific lines kits rest on, so `git log` on this
#                          file is a dated history of when a fee last moved
#   runs/index.jsonl       one summary line per run
